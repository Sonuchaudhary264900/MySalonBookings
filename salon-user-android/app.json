{
  "expo": {
    "name": "My Salon Bookings",
    "slug": "salon-user-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysalonbookings.user"
    },
    "android": {
      "package": "com.mysalonbookings.user",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon1.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow My Salon Bookings to use your location to find nearby salons."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
