{
  "expo": {
    "name": "MySalonBookings",
    "slug": "salon-user-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/original-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/original-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysalonbookings.user",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mysalonbookings.user",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/original-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLocalProperties",
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "icon": "./assets/original-icon.png",
          "color": "#2563eb",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow My Salon Bookings to use your location to find nearby salons."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "newArchEnabled": false,
    "owner": "sonuchaudhary264900",
    "extra": {
      "eas": {
        "projectId": "91c3049c-d248-4187-8414-d044535ff4b2"
      }
    }
  }
}
