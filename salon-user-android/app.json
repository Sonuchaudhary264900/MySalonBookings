{
  "expo": {
    "name": "Salon Bookings",
    "slug": "salon-user-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysalonbookings.user",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.mysalonbookings.user",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon1.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/Icon-1024.png",
          "color": "#2563eb",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow My Salon Bookings to use your location to find nearby salons."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Salon Bookings to access your photos to update your profile picture.",
          "cameraPermission": "Allow My Salon Bookings to use your camera to take a profile picture."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "owner": "sonuchaudhary264900",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
