# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ==========================================
# DATABASE CONFIGURATION (MongoDB)
# ==========================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/GlowLoox
# MongoDB Atlas (Cloud) — URL-encode special chars in the password (@ -> %40)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/GlowLoox?retryWrites=true&w=majority

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_strong_random_refresh_secret_here
JWT_REFRESH_EXPIRE=7d

# ==========================================
# GOOGLE MAPS API
# ==========================================
# Get key from: https://console.cloud.google.com → APIs → Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# CLOUDINARY (Image Upload)
# ==========================================
# Sign up at: https://cloudinary.com → Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# GMAIL SMTP (Email Service)
# ==========================================
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an app password and paste it below
GMAIL_ENABLED=false
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ==========================================
# RAZORPAY (Payment Gateway)
# ==========================================
# Sign up at: https://razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard → Settings → Webhooks → create a webhook, set the secret here.
# Used to verify incoming payment webhooks (wallet recharge + booking reconciliation).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==========================================
# WHATSAPP CLOUD API (Meta)
# ==========================================
# IMPORTANT: use a PERMANENT System User token, not the 24h temporary dev token.
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Template names — only set these if your approved template names differ from the
# code defaults (booking_confirmation, appointment_reminder_10min,
# appointment_reminder_1h, appointment_delay_alert). Language must be "en".
WHATSAPP_BOOKING_TEMPLATE=booking_confirmation
WHATSAPP_REMINDER_10MIN_TEMPLATE=appointment_reminder_10min
WHATSAPP_REMINDER_1H_TEMPLATE=appointment_reminder_1h
WHATSAPP_DELAY_ALERT_TEMPLATE=appointment_delay_alert

# ==========================================
# FAST2SMS — DLT transactional SMS (TRAI/Jio DLT)
# ==========================================
# The DLT portal only registers templates; Fast2SMS actually delivers the SMS.
# Used as a FALLBACK when WhatsApp isn't delivered (booking/reminder/status/delay)
# and directly for OTP. See docs/SMS_TEMPLATES.md for the exact template text to
# register on DLT + how to find each numeric template (Message) ID in Fast2SMS.
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=YOUR6CHARHEADER
FAST2SMS_OTP_TEMPLATE_ID=
FAST2SMS_BOOKING_TEMPLATE_ID=
FAST2SMS_REMINDER_TEMPLATE_ID=
FAST2SMS_DELAY_TEMPLATE_ID=
FAST2SMS_STATUS_TEMPLATE_ID=

# ==========================================
# FIREBASE (phone OTP verification)
# ==========================================
FIREBASE_API_KEY=your_firebase_web_api_key

# ==========================================
# REDIS (Cache + BullMQ Queues)
# ==========================================
# Free tier: https://upstash.com  (10k req/day free)
# Or Redis Cloud: https://redis.com/try-free/
REDIS_URL=redis://localhost:6379

# ==========================================
# PROMETHEUS METRICS
# ==========================================
# Optional: protect /metrics endpoint with a token
METRICS_TOKEN=your_secret_metrics_token

# ==========================================
# CORS (Frontend URLs allowed to access backend)
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# SENTRY (error monitoring — optional)
# ==========================================
SENTRY_DSN=

# ==========================================
# STYLEAI — HAIRSTYLE RECOMMENDATION
# ==========================================
HAIRSTYLE_FEATURE_ENABLED=true
PYTHON_AI_URL=http://127.0.0.1:8001
HAIRSTYLE_INTERNAL_SECRET=your_internal_secret
HAIRSTYLE_MODEL_VERSION=v1-rules

# ==========================================
# DEVELOPER SETTINGS
# ==========================================
ALLOW_TEST_ENDPOINTS=true
