{
  "name": "mysalonbookings-backend",
  "version": "2.0.0",
  "description": "Hyper-scalable backend for MySalonBookings — Node.js + Express + Redis + BullMQ",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/selfHealingBillingTest.js",
    "test:fix": "node tests/selfHealingBillingTest.js --fix",
    "test:fix:loops": "node tests/selfHealingBillingTest.js --fix --loops 3",
    "test:url": "TEST_BASE_URL=https://mysalonbookings.onrender.com/api/v1 node tests/selfHealingBillingTest.js",
    "test:legacy": "node tests/subscriptionTest.js",
    "lint": "eslint .",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "barber",
    "salon",
    "booking",
    "appointment",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@sentry/node": "^10.45.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.1",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.2",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "prom-client": "^15.1.3",
