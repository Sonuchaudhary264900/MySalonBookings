# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ==========================================
# DATABASE CONFIGURATION (MongoDB)
# ==========================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/smart_salon
# MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart_salon
DATABASE_NAME=smart_salon

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_strong_random_refresh_secret_here
JWT_REFRESH_EXPIRE=7d

# ==========================================
# GOOGLE MAPS API
# ==========================================
# Get key from: https://console.cloud.google.com → APIs → Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# CLOUDINARY (Image Upload)
# ==========================================
# Sign up at: https://cloudinary.com → Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# GMAIL SMTP (Email Service)
# ==========================================
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an app password and paste it below
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ==========================================
# TWILIO (SMS/OTP)
# ==========================================
# Sign up at: https://www.twilio.com → Console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# RAZORPAY (Payment Gateway)
# ==========================================
# Sign up at: https://razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# ADMIN CREDENTIALS (First-time setup)
# ==========================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password

# ==========================================
# CORS (Frontend URLs allowed to access backend)
# ==========================================
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:3001

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_FILE_SIZE=5242880
MAX_UPLOAD_FILES=10

# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_NAME=Smart Barber Booking System
APP_VERSION=1.0.0
APP_URL=http://localhost:5000

# ==========================================
# LOGGING
# ==========================================
LOG_FILE=logs/app.log
LOG_ERROR_FILE=logs/error.log
LOG_REQUESTS=true

# ==========================================
# DEVELOPER SETTINGS
# ==========================================
ALLOW_TEST_ENDPOINTS=true
