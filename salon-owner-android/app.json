{
  "expo": {
    "name": "My Salon Bookings",
    "slug": "salon-owner-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysalonbookings.owner"
    },
    "android": {
      "package": "com.mysalonbookings.owner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon1.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#4f46e5"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Salon Bookings to access your photos to update your profile picture.",
          "cameraPermission": "Allow My Salon Bookings to use your camera to take a profile picture."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5e4c49cf-c136-42ec-bc53-389502b5a417"
      }
    }
  }
}
