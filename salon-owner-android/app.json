{
  "expo": {
    "name": "GlowLoox Partner",
    "slug": "salon-owner-android",
    "scheme": "glowloox-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysalonbookings.owner",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mysalonbookings.owner",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#4C1D95"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuildFix",
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "icon": "./assets/Icon-1024.png",
          "color": "#2563eb",
          "sounds": [
            "./assets/sounds/new_booking.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GlowLoox to access your photos to update your salon and profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GlowLoox to use your location."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GlowLoox to access your photos.",
          "savePhotosPermission": "Allow GlowLoox to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GlowLoox to access your camera to scan UPI QR codes for withdrawals."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e4c49cf-c136-42ec-bc53-389502b5a417"
      }
    },
    "newArchEnabled": true,
    "owner": "sonuchaudhary264900"
  }
}
