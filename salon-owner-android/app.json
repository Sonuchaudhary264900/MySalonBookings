{
  "expo": {
    "name": "My Salon Bookings",
    "slug": "salon-owner-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysalonbookings.owner",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.mysalonbookings.owner",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#07071a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuildFix",
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "icon": "./assets/Icon-1024.png",
          "color": "#2563eb",
          "sounds": [
            "./assets/sounds/new_booking.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Salon Bookings to access your photos to update your salon and profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow My Salon Bookings to use your location."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow My Salon Bookings to access your photos.",
          "savePhotosPermission": "Allow My Salon Bookings to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5e4c49cf-c136-42ec-bc53-389502b5a417"
      }
    },
    "newArchEnabled": true,
    "owner": "sonuchaudhary264900"
  }
}
